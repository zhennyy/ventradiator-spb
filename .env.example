# Токен Telegram-бота от @BotFather
BOT_TOKEN=
# ID чата или группы, куда приходят заявки
CHAT_ID=
# Порт сервера (по умолчанию 3000)
PORT=3000
# Адрес сайта для sitemap.xml и Open Graph (используется при сборке)
SITE_URL=https://example.ru
# 1 — если сайт стоит за nginx/прокси (чтобы ограничение частоты считало реальные IP)
TRUST_PROXY=
