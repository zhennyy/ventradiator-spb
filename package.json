{
  "name": "blizzard-spb-catalog",
  "version": "2.0.0",
  "private": true,
  "description": "Сайт-каталог представительства Blizzard Lufttechnik в Санкт-Петербурге",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-server",
    "prerender": "node scripts/prerender.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "serve": "npm run build && npm start",
    "test": "vitest run",
    "smoke": "node tools/smoke.js --out /tmp/blizzard-shots",
    "screens": "node tools/screens.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "express": "^4.22.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
